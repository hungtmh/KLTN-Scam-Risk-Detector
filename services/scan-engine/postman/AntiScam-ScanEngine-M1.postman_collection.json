{
  "info": {
    "name": "Anti-Scam · Scan Engine M1",
    "description": "Bộ test cho POST /v1/scan/text — mốc M1 (rule engine đồng bộ, chưa có DB/auth/LLM).\n\nChạy server trước:\n  cd services/scan-engine\n  uvicorn app.main:app --reload --port 8000\n\nSau đó Run collection. Toàn bộ 14 request phải xanh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "type": "string" }
  ],
  "item": [
    {
      "name": "0 · Hạ tầng",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('service UP', () => pm.expect(b.status).to.eql('UP'));",
                  "pm.test('đã nạp rule', () => pm.expect(b.ruleCount).to.be.above(0));",
                  "console.log('Rules version:', b.rulesVersion, '| số rule:', b.ruleCount);"
                ]
              }
            }
          ]
        },
        {
          "name": "Danh sách rule đang hoạt động",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/rules/active", "host": ["{{baseUrl}}"], "path": ["v1", "rules", "active"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rules = pm.response.json();",
                  "pm.test('có rule', () => pm.expect(rules.length).to.be.above(0));",
                  "pm.test('không lộ điều kiện rule ra ngoài', () => {",
                  "  rules.forEach(r => pm.expect(Object.keys(r).sort()).to.eql(['category','code','name','severity','weight']));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Nghiệp vụ — phải bắt được",
      "item": [
        {
          "name": "TC01 · SMS giả mạo Vietcombank (DANGER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"THÔNG BÁO: Tài khoản của quý khách sắp bị khóa. Vui lòng xác minh ngay tại http://vietc0mbank.com hoặc gọi 0912345678\",\n  \"source\": \"SMS\",\n  \"saveHistory\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/scan/text", "host": ["{{baseUrl}}"], "path": ["v1", "scan", "text"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('DANGER', () => pm.expect(d.result.riskLevel).to.eql('DANGER'));",
                  "pm.test('điểm >= 70', () => pm.expect(d.result.riskScore).to.be.at.least(70));",
                  "pm.test('màu đỏ', () => pm.expect(d.result.levelColor).to.eql('RED'));",
                  "pm.test('khuyến nghị chặn', () => pm.expect(d.recommendation.action).to.eql('BLOCK'));",
                  "const codes = d.evidences.map(e => e.ruleCode);",
                  "pm.test('nhận ra mẫu giả mạo ngân hàng', () => pm.expect(codes).to.include('PATTERN_BANK_IMPERSONATION'));",
                  "pm.test('bắt được tên miền giả mạo', () => pm.expect(codes).to.include('URL_TYPOSQUAT_BRAND'));",
                  "pm.test('trích xuất được số điện thoại chuẩn hoá', () => pm.expect(d.analysis.extractedEntities.phoneNumbers).to.include('+84912345678'));",
                  "console.log('Score', d.result.riskScore, '| rules:', codes.join(', '));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC02 · Trúng thưởng đòi phí (DANGER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Bạn đã trúng thưởng 100 triệu đồng! Vui lòng đóng phí 500k để nhận giải thưởng.\",\n  \"source\": \"ZALO\"\n}"
