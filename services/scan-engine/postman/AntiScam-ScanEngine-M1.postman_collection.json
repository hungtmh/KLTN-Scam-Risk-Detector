    {
      "name": "3 · Hợp đồng JSON & tính xác định",
      "item": [
        {
          "name": "TC10 · Response đúng API Specification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Chuyển khoản 500k vào STK 19001234567 rồi gọi 0912345678, chi tiết tại http://vietc0mbank.com\",\n  \"source\": \"SMS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/scan/text", "host": ["{{baseUrl}}"], "path": ["v1", "scan", "text"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('có success + data', () => { pm.expect(b.success).to.be.true; pm.expect(b.data).to.be.an('object'); });",
                  "const d = b.data;",
                  "pm.test('đủ khối theo spec', () => pm.expect(d).to.include.keys('scanId','input','result','analysis','evidences','recommendation','scannedAt','processingTime'));",
                  "pm.test('result đúng 4 trường', () => pm.expect(Object.keys(d.result).sort()).to.eql(['confidence','levelColor','riskLevel','riskScore']));",
                  "pm.test('điểm trong [0,100]', () => { pm.expect(d.result.riskScore).to.be.at.least(0); pm.expect(d.result.riskScore).to.be.at.most(100); });",
                  "pm.test('extractedEntities đủ 5 nhóm', () => pm.expect(Object.keys(d.analysis.extractedEntities).sort()).to.eql(['amounts','bankAccounts','otpCodes','phoneNumbers','urls']));",
                  "pm.test('mọi evidence đều có ruleCode truy ngược được', () => {",
                  "  pm.expect(d.evidences.length).to.be.above(0);",
                  "  d.evidences.forEach(e => {",
                  "    pm.expect(e.ruleCode, 'ruleCode').to.be.a('string').and.not.empty;",
                  "    pm.expect(e.ruleName, 'ruleName').to.be.a('string').and.not.empty;",
                  "    pm.expect(['LOW','MEDIUM','HIGH','CRITICAL']).to.include(e.severity);",
                  "    pm.expect(e.source).to.eql('rule');",
                  "  });",
                  "});",
                  "pm.test('điểm = tổng evidence (không có điểm nào vô căn cứ)', () => {",
                  "  const total = d.evidences.reduce((s, e) => s + e.score, 0);",
                  "  pm.expect(d.result.riskScore).to.eql(Math.max(0, Math.min(100, total)));",
                  "});",
                  "pm.test('SĐT không bị đếm nhầm thành số tài khoản', () => pm.expect(d.analysis.extractedEntities.bankAccounts).to.not.include('0912345678'));",
                  "pm.collectionVariables.set('lastScore', d.result.riskScore);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC11 · Tính xác định — gửi lại phải ra đúng điểm cũ",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Chuyển khoản 500k vào STK 19001234567 rồi gọi 0912345678, chi tiết tại http://vietc0mbank.com\",\n  \"source\": \"SMS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/scan/text", "host": ["{{baseUrl}}"], "path": ["v1", "scan", "text"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "const before = Number(pm.collectionVariables.get('lastScore'));",
                  "pm.test('cùng input → cùng điểm (rule engine, không phải LLM)', () => pm.expect(d.result.riskScore).to.eql(before));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 · Validate đầu vào",
      "item": [
        {
          "name": "TC12 · text rỗng → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"\",\n  \"source\": \"SMS\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/scan/text", "host": ["{{baseUrl}}"], "path": ["v1", "scan", "text"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test('đúng định dạng lỗi của dự án', () => {",
                  "  pm.expect(b.success).to.be.false;",
                  "  pm.expect(b.error.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(b.error.details).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC13 · text > 5000 ký tự → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"{{longText}}\",\n  \"source\": \"SMS\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/scan/text", "host": ["{{baseUrl}}"], "path": ["v1", "scan", "text"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('longText', 'a'.repeat(5001));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('mã lỗi đúng', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC14 · source không hợp lệ → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"xin chào\",\n  \"source\": \"TELEGRAM\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/scan/text", "host": ["{{baseUrl}}"], "path": ["v1", "scan", "text"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('chỉ ra đúng field sai', () => pm.expect(JSON.stringify(pm.response.json().error.details)).to.include('source'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
